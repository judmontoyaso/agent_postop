# LLM — Groq (Llama 3.1 70B) — modelo declarado del stack cerrado (G3).
# Groq descontinuó llama-3.1-70b-versatile (24 ene 2025); usamos su reemplazo
# directo llama-3.3-70b-versatile (mismo linaje Llama 70B vía Groq).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# THINK_PROVIDER=openai es solo para testear si Groq se queda sin cuota
# durante el desarrollo — dejar en "groq" para la entrega/demo final.
THINK_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Voz — Deepgram (STT streaming + TTS streaming, sin restricción de stack)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_TTS_MODEL=aura-2-celeste-es

# RAG — embedder local multilingüe (sin dependencia de red/rate limits en runtime)
CHROMA_DB_PATH=./data/chroma
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# App
ADMIN_DB_PATH=./data/admin.db
METRICS_DB_PATH=./data/metrics.db
DATASET_DIR=./dataset
API_PORT=8000
