# LLM — Groq (Llama 3.1 70B) — modelo declarado del stack cerrado (G3).
# Groq descontinuó llama-3.1-70b-versatile (24 ene 2025); usamos su reemplazo
# directo llama-3.3-70b-versatile (mismo linaje Llama 70B vía Groq).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Qué modelo razona en el agente. G3 permite FAMILIAS, no versiones exactas:
#   groq   -> Meta Llama vía Groq      (permitido; menor latencia, techo 12000 TPM)
#   google -> Google Gemini gama Flash (permitido; techo de tokens mucho más alto)
#   openai -> NO PERMITIDO, descalifica. Solo depuración local.
THINK_PROVIDER=groq

# Gemini — key de Google AI Studio (las de Vertex AI / Workspace NO funcionan;
# dan 403 API_KEY_SERVICE_BLOCKED). Sácala de https://aistudio.google.com/apikey
# Modelos verificados que responden Y que Deepgram soporta:
#   gemini-3.5-flash, gemini-3.1-flash-lite, gemini-3-flash-preview
# gemini-2.5-flash y gemini-2.0-flash-lite ya NO están disponibles.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Voz — Deepgram (STT streaming + TTS streaming, sin restricción de stack)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_TTS_MODEL=aura-2-celeste-es

# RAG — embedder local multilingüe (sin dependencia de red/rate limits en runtime)
CHROMA_DB_PATH=./data/chroma
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# App
ADMIN_DB_PATH=./data/admin.db
METRICS_DB_PATH=./data/metrics.db
DATASET_DIR=./dataset
API_PORT=8000
