# LLM — Meta Llama vía Groq — modelo declarado (G3).
# Groq descontinuó llama-3.1-70b-versatile (24 ene 2025); llama-3.3-70b-versatile
# es su sucesor vigente en el mismo proveedor y la misma familia.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Qué modelo razona en el agente. G3 permite FAMILIAS, no versiones exactas:
#   groq   -> Meta Llama vía Groq      (permitido; menor latencia)
#   google -> Google Gemini gama Flash (permitido; otra cuota, sirve de respaldo)
#   openai -> NO PERMITIDO, descalifica. Solo depuración local.
# Con GROQ_API_KEY y GEMINI_API_KEY puestas se activa el failover automático:
# cuando una cuota se agota la llamada sigue con el otro proveedor.
THINK_PROVIDER=groq

# Gemini — key de Google AI Studio (las de Vertex AI / Workspace NO funcionan;
# dan 403 API_KEY_SERVICE_BLOCKED). Sácala de https://aistudio.google.com/apikey
# Límites del tier gratis medidos contra una cuenta real:
#   gemini-3.1-flash-lite  -> el que más margen tiene (recomendado)
#   gemini-3-flash-preview -> 5 peticiones/minuto
#   gemini-3.5-flash       -> 20 peticiones AL DÍA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Voz — Deepgram (STT streaming + TTS streaming, sin restricción de stack)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-celeste-es

# RAG — embedder local multilingüe (sin dependencia de red/rate limits en runtime)
CHROMA_DB_PATH=./data/chroma
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# App
ADMIN_DB_PATH=./data/admin.db
METRICS_DB_PATH=./data/metrics.db
DATASET_DIR=./dataset
API_PORT=8000

# Webhook al que se avisa cuando una llamada escala a amarillo o rojo. Es el
# único punto donde el escalamiento sale del sistema: sin esto queda registrado
# pero nadie en la clínica se entera. Opcional — si está vacío, la llamada
# funciona igual y el aviso se registra en el log.
# Para la demo sirve el buzón local incluido:
#   ESCALATION_WEBHOOK_URL=http://127.0.0.1:8000/api/escalations/inbox
ESCALATION_WEBHOOK_URL=
